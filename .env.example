# Copy to IaC/.env and fill in — never commit the real .env
VAULT_ADDR=https://<openbao-host>:8200
VAULT_SKIP_VERIFY=true
VAULT_BOOTSTRAP_TOKEN=<token scoped to generate Secret IDs>
VAULT_ROLE_ID=<approle role id>
TF_VAR_proxmox_endpoint=https://<proxmox-host>:8006
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
